# URL pública deste ambiente — usada em canonical, sitemap, Open Graph e llms.txt
NEXT_PUBLIC_SITE_URL=https://espacodacompletude.com.br

# Ambiente. Só 'producao' libera indexação pelo Google e pelos crawlers de IA.
# Em beta/homologação use qualquer outro valor (ex.: 'beta') para forçar noindex.
NEXT_PUBLIC_AMBIENTE=producao

# --- Google (opcional) ---
# Enquanto estas duas variáveis estiverem vazias, NADA do Google é carregado e o
# banner de cookies nem aparece. Ao preencher, o Consent Mode v2 entra em ação:
# tudo negado por padrão, e as tags só carregam depois do "aceitar".
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Opcional: importação automática dos vídeos do YouTube
# YOUTUBE_API_KEY=
# YOUTUBE_CHANNEL_ID=UCqSwKBMOCEGFCJch2e_jD9w
